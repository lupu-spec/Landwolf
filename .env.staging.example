APP_ENV=staging
SECRET_KEY=GENERATE_A_UNIQUE_RANDOM_SECRET_AND_INJECT_FROM_SECRET_MANAGER
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@STAGING_DB_HOST:5432/property_intelligence
CORS_ORIGINS=https://staging.example.com
JWT_EXPIRE_MINUTES=60

AUTH_COOKIE_NAME=upi_staging_session
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=strict
COOKIE_DOMAIN=
COOKIE_PATH=/

STRIPE_SECRET_KEY=sk_test_REPLACE_FROM_SECRET_MANAGER
STRIPE_MONTHLY_PRICE_ID=price_replace_me
STRIPE_ANNUAL_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_FROM_SECRET_MANAGER
