{
  "name": "landwolf-beta-ui",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format:check": "prettier --check web tests/*.test.mjs scripts/build.mjs package.json tsconfig.json eslint.config.js",
    "format": "prettier --write web tests/*.test.mjs scripts/build.mjs package.json tsconfig.json eslint.config.js",
    "lint": "eslint web/*.ts tests/*.test.mjs scripts/build.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "audit": "npm audit --audit-level=moderate",
    "secrets": "secretlint \"**/*\" ../AGENTS.md ../render.beta.yaml ../render.staging.yaml ../.github/workflows/beta.yml --no-terminalLink"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@types/leaflet": "1.9.21",
    "agent-browser": "0.37.1",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "globals": "^17.0.0",
    "prettier": "3.9.6",
    "secretlint": "13.0.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
